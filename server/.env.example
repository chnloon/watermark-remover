# ═══════════════════════════════════════════════════════════════
#  链接解析服务 - 环境变量模板
#
#  复制为 .env 并填写实际值：  cp .env.example .env
#  ⚠️ .env 已被 .gitignore 忽略，切勿提交到 git
# ═══════════════════════════════════════════════════════════════

# ── 运行环境 ──────────────────────────────────────────────────
# production 下若缺少 JWT_SECRET，服务将拒绝启动
NODE_ENV=production
PORT=3001

# ── JWT（必填）────────────────────────────────────────────────
# 生成方式: openssl rand -hex 32
# 或运行: bash setup.sh（自动生成并写入 .env）
JWT_SECRET=

# ── 微信小程序（登录接口需要）──────────────────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── 第三方解析 API（可选，自研免费链路默认已覆盖）──────────────
# 可选值: bugpk | layzz | media-parser | custom | tiktokapi （留空/删除=不启用）
# ⭐ bugpk = 免费免 key（备选解析方案推荐：直连链路被平台风控时的一键止损线路）
THIRD_PARTY_API_TYPE=
# bugpk 免费接口（默认值即可，一般无需修改）
BUGPK_ENDPOINT=https://api.bugpk.com/api/douyin
# layzz 付费服务
LAYZZ_ENDPOINT=https://proxy.layzz.cn/lyz/platAnalyse/
LAYZZ_TOKEN=
# 自建 media-parser
MEDIA_PARSER_ENDPOINT=http://127.0.0.1:8051/api/parse
# custom / tiktokapi 通用
THIRD_PARTY_ENDPOINT=
THIRD_PARTY_API_KEY=

# ── 管理接口（可选，备选解析方案远程一键切换线路用）────────────
# 配置后可用: curl -X POST http://127.0.0.1:3001/api/admin/route
#   -H "Content-Type: application/json" -H "X-Admin-Token: <ADMIN_TOKEN>"
#   -d '{"mode":"third-party-only","by":"ops","reason":"直连链路故障"}'
# 生成方式: openssl rand -hex 16
# 本机运维推荐直接用 scripts/switch-route.sh（无需此 token）
ADMIN_TOKEN=
