# ═══════════════════════════════════════════════════════════════
#  链接解析服务 - 环境变量模板
#
#  复制为 .env 并填写实际值：  cp .env.example .env
#  ⚠️ .env 已被 .gitignore 忽略，切勿提交到 git
# ═══════════════════════════════════════════════════════════════

# ── 运行环境 ──────────────────────────────────────────────────
# production 下若缺少 JWT_SECRET，服务将拒绝启动
NODE_ENV=production
PORT=3001

# ── JWT（必填）────────────────────────────────────────────────
# 生成方式: openssl rand -hex 32
# 或运行: bash setup.sh（自动生成并写入 .env）
JWT_SECRET=

# ── 微信小程序（登录接口需要）──────────────────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── 第三方解析 API（可选，自研免费链路默认已覆盖）──────────────
# 可选值: layzz | media-parser | custom | tiktokapi （留空/删除=不启用）
THIRD_PARTY_API_TYPE=
# layzz 付费服务
LAYZZ_ENDPOINT=https://proxy.layzz.cn/lyz/platAnalyse/
LAYZZ_TOKEN=
# 自建 media-parser
MEDIA_PARSER_ENDPOINT=http://127.0.0.1:8051/api/parse
# custom / tiktokapi 通用
THIRD_PARTY_ENDPOINT=
THIRD_PARTY_API_KEY=
