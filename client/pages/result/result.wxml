<!-- ========================================
     结果页 — 视频/图片展示 (Apple Music Style)
     ======================================== -->

<view class="page page--result">

  <!-- 背景：随机浅色底色 + 柔光层（玻璃卡片透出它才有材质感） -->
  <view class="bg-tint" style="background: {{bgTint}}"></view>
  <view class="bg-glow" aria-hidden="true">
    <view class="bg-glow__orb bg-glow__orb--blue"></view>
    <view class="bg-glow__orb bg-glow__orb--violet"></view>
    <view class="bg-glow__orb bg-glow__orb--cyan"></view>
    <view class="bg-glow__orb bg-glow__orb--pink"></view>
    <view class="bg-glow__orb bg-glow__orb--orange"></view>
  </view>

  <!-- ===== 骨架屏加载 ===== -->
  <view wx:if="{{!resultData}}" class="skeleton-result">
    <view class="skeleton skeleton-result__bar"></view>
    <view class="skeleton skeleton-result__card"></view>
    <view class="skeleton-result__btns">
      <view class="skeleton skeleton-result__btn"></view>
      <view class="skeleton skeleton-result__btn"></view>
    </view>
  </view>

  <!-- ===== 结果内容 ===== -->
  <view wx:else class="result-container">

    <!-- 顶部留白（无返回按钮） -->
    <view class="result-header fade-in-up">
    </view>

    <!-- ===== 视频预览卡片 (Apple Music 风格) ===== -->
    <view wx:if="{{resultData.data.type === 'video'}}" class="media-card fade-in-up--d1">
      <view class="media-card__video-wrap">
        <video
          wx:if="{{hasVideoUrl}}"
          class="media-card__video"
          src="{{resultData.data.proxyVideoUrl || resultData.data.videoUrl}}"
          controls
          autoplay="{{false}}"
          object-fit="contain"
          background="#e9ebf1"
          poster="{{resultData.data.videoCover || resultData.data.coverUrl || ''}}"
          bindready="onVideoReady"
          binderror="onVideoError"
        />
        <!-- 无视频地址兜底：浅色占位，避免空 src 黑底 -->
        <view wx:else class="media-card__video-placeholder">
          <text class="video-status">视频地址缺失，请重新解析</text>
        </view>
      </view>

      <!-- 错误状态 + 重试 -->
      <view wx:if="{{hasVideoUrl && videoError}}" class="media-card__status-error shake">
        <text class="media-card__error-text">⛔ 播放失败</text>
        <text class="media-card__error-hint">请检查网络或切换播放源</text>
        <button class="media-card__retry-btn" bindtap="onVideoRetry">重试</button>
      </view>
    </view>

    <!-- ===== 图片预览 (网格 + 多选) ===== -->
    <view wx:if="{{resultData.data.type === 'image'}}" class="media-card media-card--image fade-in-up--d1">
      <!-- 顶部工具栏: 标题 + 全选/全不选切换按钮 -->
      <view class="image-toolbar">
        <text class="image-toolbar__title">共 {{resultData.data.images.length}} 张图片</text>
        <view class="image-toolbar__btns">
          <text
            class="image-toolbar__btn {{allSelected ? 'image-toolbar__btn--none' : ''}}"
            bindtap="onToggleSelectAll"
          >{{allSelected ? '全不选' : '全选'}}</text>
        </view>
      </view>

      <!-- 图片横向滑动列表: 每张图可点选 -->
      <scroll-view class="image-hscroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="image-hscroll__inner">
          <view
            class="image-card {{selectedImages[index] ? 'image-card--selected' : ''}}"
            wx:for="{{resultData.data.images}}"
            wx:key="*this"
            data-index="{{index}}"
            bindtap="onToggleImage"
          >
            <!-- 多源兜底: 直连图床失败时自动切换到代理地址 -->
            <image
              wx:if="{{!imageErrors[index]}}"
              class="image-card__img"
              src="{{item}}"
              mode="aspectFill"
              lazy-load
              binderror="onImageError"
              data-index="{{index}}"
            />
            <image
              wx:elif="{{resultData.data.proxyImages && resultData.data.proxyImages[index]}}"
              class="image-card__img"
              src="{{resultData.data.proxyImages[index]}}"
              mode="aspectFill"
              lazy-load
              binderror="onImageError"
              data-index="{{index}}"
            />
            <!-- 全部失败占位 -->
            <view wx:else class="image-card__img image-card__img--fallback">
              <text class="image-card__fallback-text">加载失败</text>
            </view>
            <!-- 勾选标记（右上角圆形） -->
            <view class="image-card__check {{selectedImages[index] ? 'image-card__check--on' : ''}}">
              <text wx:if="{{selectedImages[index]}}" class="image-card__check-icon">✓</text>
            </view>
            <!-- 序号 -->
            <text class="image-card__index">{{index + 1}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 选中状态提示 -->
      <view class="image-select-hint">
        <text wx:if="{{selectedCount > 0}}" class="image-select-hint__text">已选 {{selectedCount}} 张</text>
        <text wx:else class="image-select-hint__text">左右滑动选择要保存的图片</text>
      </view>
    </view>

    <!-- ===== 列表展示 (网页视频提取) ===== -->
    <view wx:elif="{{resultData.data.type === 'list'}}" class="list-section fade-in-up--d1">
      <view class="list-section__header">
        <text class="list-section__title">{{resultData.data.title || '找到以下视频'}}</text>
        <text class="list-section__count">{{resultData.data.items.length}} 个视频</text>
      </view>

      <scroll-view class="list-section__scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          class="list-card"
          wx:for="{{resultData.data.items}}"
          wx:key="id"
          wx:for-item="video"
          wx:for-index="vidx"
        >
          <!-- 封面 -->
          <image
            class="list-card__cover"
            src="{{video.coverUrl || resultData.data.coverUrl || ''}}"
            mode="aspectFill"
            lazy-load
          />

          <!-- 信息区 -->
          <view class="list-card__body">
            <text class="list-card__title">{{video.title || '视频'}}</text>
            <view class="list-card__meta">
              <text class="list-card__badge">{{video.format || '视频'}}</text>
            </view>
          </view>

          <!-- 下载按钮 -->
          <button
            class="list-card__btn {{isSavingListItem && currentSaveIndex === vidx ? 'list-card__btn--saving' : ''}}"
            data-index="{{vidx}}"
            bindtap="onSaveListItem"
            disabled="{{isSavingListItem && currentSaveIndex !== vidx}}"
          >
            {{isSavingListItem && currentSaveIndex === vidx ? '保存中...' : '保存'}}
          </button>
        </view>
      </scroll-view>
    </view>

    <!-- ===== iOS 风格操作按钮组 ===== -->
    <view class="action-group fade-in-up--d2">

      <!-- 第一行：保存 -->
      <view class="action-group__row">
        <button
          wx:if="{{resultData.data.type === 'video'}}"
          class="action-btn action-btn--primary"
          bindtap="onSaveVideo"
          disabled="{{isSaving}}"
        >
          <text class="action-btn__label">{{isSaving ? '保存中...' : '保存到相册'}}</text>
        </button>
        <button
          wx:if="{{resultData.data.type === 'image'}}"
          class="action-btn action-btn--primary"
          bindtap="onSaveImages"
          disabled="{{isSaving}}"
        >
          <text class="action-btn__label">{{isSaving ? '保存中...' : '保存图片'}}</text>
        </button>
      </view>

      <!-- 第二行：辅助操作 -->
      <view class="action-group__row action-group__row--secondary">
        <button class="action-btn action-btn--secondary" bindtap="onCopyLink" data-link="{{resultData.data.type === 'image' ? (resultData.data.proxyImages ? resultData.data.proxyImages[0] : resultData.data.images[0]) : (resultData.data.proxyVideoUrl || resultData.data.videoUrl)}}">
          <text class="action-btn__label">复制链接</text>
        </button>
        <button wx:if="{{resultData.data.title}}" class="action-btn action-btn--secondary" bindtap="onCopyDesc">
          <text class="action-btn__label">复制文案</text>
        </button>
        <button class="action-btn action-btn--secondary" bindtap="onGoHome">
          <text class="action-btn__label">继续解析</text>
        </button>
      </view>
    </view>

    <!-- 保存进度 -->
    <view wx:if="{{imageSaveProgress}}" class="save-progress fade-in-up--d3">
      <view class="save-progress__bar">
        <view
          class="save-progress__fill"
          style="width: {{(imageSaveProgress.current / imageSaveProgress.total) * 100}}%"
        ></view>
      </view>
      <text class="save-progress__text">
        正在保存 {{imageSaveProgress.current}} / {{imageSaveProgress.total}}
      </text>
    </view>

    <!-- 底部重新解析栏 -->
    <view class="reparse-bar fade-in-up--d3">
      <view class="reparse-bar__input-wrap">
        <input
          class="reparse-bar__input"
          placeholder="粘贴新链接继续解析..."
          placeholder-class="reparse-bar__placeholder"
          value="{{currentUrl}}"
          bindinput="onUrlInput"
          maxlength="-1"
          confirm-type="search"
          bindconfirm="onReParse"
        />
        <button class="reparse-bar__btn {{currentUrl ? 'reparse-bar__btn--clear' : ''}}" bindtap="onReparseBarBtn">{{currentUrl ? '清空' : '粘贴'}}</button>
      </view>
    </view>

  </view>
</view>
