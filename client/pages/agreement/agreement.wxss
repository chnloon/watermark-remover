/* 用户协议与隐私保护指引 */

.page--agreement {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.agree-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.agree-head__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1f26;
  letter-spacing: 2rpx;
}

.agree-head__version {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #878c9b;
}

.agree-body {
  flex: 1;
  height: 0;
}

.agree-section {
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
}

.agree-section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b6cff;
  margin-bottom: 16rpx;
}

.agree-section__text {
  font-size: 27rpx;
  line-height: 1.9;
  color: #3d4250;
  margin-bottom: 12rpx;
}

.agree-footer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(135, 140, 155, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.agree-footer__text {
  font-size: 24rpx;
  color: #878c9b;
  margin-bottom: 8rpx;
}
