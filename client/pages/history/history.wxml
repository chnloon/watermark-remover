<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="header__title">📋 解析记录</text>
    <button class="header__clear" wx:if="{{historyList.length > 0}}" bindtap="onClearAll">
      清空全部
    </button>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{historyList.length === 0}}" class="empty-state">
    <text class="empty-state__icon">📭</text>
    <text class="empty-state__text">暂无解析记录</text>
    <text class="empty-state__hint">解析成功后会自动保存到这里</text>
    <button class="btn-go-parse" bindtap="onGoParse">去解析 →</button>
  </view>

  <!-- 历史列表 -->
  <view wx:else class="history-list">
    <view
      class="history-item"
      wx:for="{{historyList}}"
      wx:key="id"
      bindtap="onReParse"
      data-url="{{item.url}}"
    >
      <image
        class="history-item__cover"
        src="{{item.coverUrl || '/assets/icons/default_cover.png'}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="history-item__info">
        <text class="history-item__title">{{item.title}}</text>
        <view class="history-item__meta">
          <text class="platform-tag {{'platform-tag--' + item.platform}}">
            {{platformNames[item.platform] || item.platform}}
          </text>
          <text class="history-item__type">{{item.type === 'video' ? '🎬 视频' : '🖼️ 图片'}}</text>
          <text class="history-item__time">{{formatTime(item.timestamp)}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
